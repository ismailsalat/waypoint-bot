# ============================================================
# REQUIRED — secrets and machine configuration.
# These are the only values you need in this file, and the only
# ones that cannot be changed from the dashboard.
# ============================================================

# From https://discord.com/developers/applications -> your app -> Bot.
DISCORD_BOT_TOKEN=

# OPTIONAL LOCALLY. Leave it out and the app creates and uses ./funnel.db
# automatically, so you never have to install PostgreSQL to develop.
#
# On Railway this one IS required: set it to ${{Postgres.DATABASE_URL}}. If
# Railway is detected without it, start-up stops with a clear error instead of
# falling back to SQLite, because Railway's filesystem is replaced on every
# deploy and a file database there would silently lose your data.
#
# Setting a PostgreSQL URL here on your own machine deliberately points the
# local dashboard at that production database. Local SQLite and Railway
# PostgreSQL are otherwise completely separate and are never synced.
# DATABASE_URL=

# Discord user IDs whose servers the bot may configure automatically, comma
# separated. This decides who is trusted, so it stays out of the dashboard.
OWNER_USER_IDS=

# ============================================================
# OPTIONAL — first-run defaults only.
#
# Each of these seeds the matching setting the first time the bot starts
# against an empty database. After that the value stored in the database
# wins and these lines are ignored, so change them on the dashboard at
# http://127.0.0.1:8000/settings rather than here. Leaving them blank is
# fine: the dashboard setup wizard asks for what it needs.
# ============================================================

# Which server is your main community. Optional: if this is blank the bot
# starts normally and waits for you to pick one on the dashboard.
MAIN_GUILD_ID=

# The only account allowed to receive test messages from the Message studio.
ADMIN_TEST_USER_ID=

# true suppresses production funnel DMs and keeps test activity out of your
# analytics. Handy as a safe default on a first deploy; toggle it on the
# Settings page afterwards.
DEVELOPMENT_MODE=true

# ============================================================
# Local dashboard. Machine level, so it stays here.
# ============================================================
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Optional absolute path for local scheduler settings/accounts.
# SCHEDULER_DATA_DIR=
